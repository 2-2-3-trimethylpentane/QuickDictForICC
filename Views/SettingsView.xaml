<UserControl x:Class="QuickDictForICC.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:p="clr-namespace:QuickDictForICC.Properties"
             xmlns:ui="clr-namespace:iNKORE.UI.WPF.Modern.Controls;assembly=iNKORE.UI.WPF.Modern.Controls"
             xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="640">
    <ScrollViewer x:Name="RootScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalFirst"
                  Padding="28,20">
        <StackPanel>
            <TextBlock Text="{x:Static p:Resources.Settings_Title}"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#222222"
                       Margin="0,0,0,8"/>
            <TextBlock Text="{x:Static p:Resources.Settings_Description}"
                       FontSize="13"
                       Foreground="#888888"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <ui:SettingsExpander Header="{x:Static p:Resources.Settings_Section_Dictionary}"
                                 IsExpanded="True"
                                 Margin="0,0,0,16">
                <ui:SettingsExpander.Items>
                    <ui:SettingsCard Header="{x:Static p:Resources.Settings_EcDictPathHeader}"
                                     Description="{x:Static p:Resources.Settings_EcDictPathDescription}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="EcDictPathTextBox"
                                     Grid.Column="0"
                                     IsReadOnly="True"/>
                            <Button x:Name="BrowseEcDictButton"
                                    Grid.Column="1"
                                    Content="{x:Static p:Resources.Settings_BrowseButton}"
                                    Margin="8,0,0,0"/>
                        </Grid>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static p:Resources.Settings_MDictPathHeader}"
                                     Description="{x:Static p:Resources.Settings_MDictPathDescription}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MDictPathTextBox"
                                     Grid.Column="0"
                                     IsReadOnly="True"/>
                            <Button x:Name="BrowseMDictButton"
                                    Grid.Column="1"
                                    Content="{x:Static p:Resources.Settings_BrowseButton}"
                                    Margin="8,0,0,0"/>
                        </Grid>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static p:Resources.Settings_MDictResourcePathHeader}"
                                     Description="{x:Static p:Resources.Settings_MDictResourcePathDescription}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MDictResourcePathTextBox"
                                     Grid.Column="0"
                                     IsReadOnly="True"/>
                            <Button x:Name="BrowseMDictResourceButton"
                                    Grid.Column="1"
                                    Content="{x:Static p:Resources.Settings_BrowseButton}"
                                    Margin="8,0,0,0"/>
                        </Grid>
                    </ui:SettingsCard>
                </ui:SettingsExpander.Items>
            </ui:SettingsExpander>

            <ui:SettingsExpander Header="{x:Static p:Resources.Settings_Section_Tts}"
                                 IsExpanded="True">
                <ui:SettingsExpander.Items>
                    <ui:SettingsCard Header="{x:Static p:Resources.Settings_TtsEngineHeader}">
                        <ComboBox x:Name="TtsEngineComboBox" SelectedIndex="0">
                            <ComboBoxItem Content="{x:Static p:Resources.Settings_TtsEngine_Edge}"/>
                            <ComboBoxItem Content="{x:Static p:Resources.Settings_TtsEngine_Piper}"/>
                        </ComboBox>
                    </ui:SettingsCard>

                    <ui:SettingsCard x:Name="EdgeVoiceCard" Header="{x:Static p:Resources.Settings_EdgeVoiceHeader}">
                        <ComboBox x:Name="EdgeVoiceComboBox" IsEditable="True">
                            <ComboBoxItem Content="{x:Static p:Resources.Settings_EdgeVoice_AriaNeural}"/>
                            <ComboBoxItem Content="{x:Static p:Resources.Settings_EdgeVoice_GuyNeural}"/>
                            <ComboBoxItem Content="{x:Static p:Resources.Settings_EdgeVoice_SoniaNeural}"/>
                            <ComboBoxItem Content="{x:Static p:Resources.Settings_EdgeVoice_EmmaMultilingualNeural}"/>
                            <ComboBoxItem Content="{x:Static p:Resources.Settings_EdgeVoice_JennyNeural}"/>
                            <ComboBoxItem Content="{x:Static p:Resources.Settings_EdgeVoice_RyanNeural}"/>
                            <ComboBoxItem Content="{x:Static p:Resources.Settings_EdgeVoice_NatashaNeural}"/>
                        </ComboBox>
                    </ui:SettingsCard>
                    <ui:SettingsCard x:Name="EdgeRateCard" Header="{x:Static p:Resources.Settings_EdgeRateHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="EdgeRateSlider"
                                    Grid.Column="0"
                                    Minimum="-50"
                                    Maximum="50"
                                    Value="0"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="EdgeRateValueText"
                                       Grid.Column="1"
                                       Text="{x:Static p:Resources.Settings_EdgeRateDefault}"
                                       MinWidth="48"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"/>
                        </Grid>
                    </ui:SettingsCard>
                    <ui:SettingsCard x:Name="PiperExecutableCard"
                                     Header="{x:Static p:Resources.Settings_PiperExecutableHeader}"
                                     Description="piper.exe">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PiperExecutablePathTextBox"
                                     Grid.Column="0"
                                     IsReadOnly="True"/>
                            <Button x:Name="BrowsePiperExecutableButton"
                                    Grid.Column="1"
                                    Content="{x:Static p:Resources.Settings_BrowseButton}"
                                    Margin="8,0,0,0"/>
                        </Grid>
                    </ui:SettingsCard>
                    <ui:SettingsCard x:Name="PiperModelCard"
                                     Header="{x:Static p:Resources.Settings_PiperModelHeader}"
                                     Description=".onnx">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PiperModelPathTextBox"
                                     Grid.Column="0"
                                     IsReadOnly="True"/>
                            <Button x:Name="BrowsePiperModelButton"
                                    Grid.Column="1"
                                    Content="{x:Static p:Resources.Settings_BrowseButton}"
                                    Margin="8,0,0,0"/>
                        </Grid>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static p:Resources.Settings_TestTtsHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TtsTestTextBox"
                                     Grid.Column="0"
                                     Text="{x:Static p:Resources.Settings_TestTextDefault}"/>
                            <Button x:Name="TestTtsButton"
                                    Grid.Column="1"
                                    Content="{x:Static p:Resources.Settings_TestTtsButton}"
                                    Margin="8,0,0,0"/>
                        </Grid>
                    </ui:SettingsCard>
                </ui:SettingsExpander.Items>
            </ui:SettingsExpander>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button x:Name="SaveButton"
                        Content="{x:Static p:Resources.Settings_SaveButton}"
                        Margin="0,0,8,0"/>
                <Button x:Name="ClearCacheButton"
                        Content="{x:Static p:Resources.Settings_ClearCacheButton}"/>
            </StackPanel>

            <TextBlock x:Name="StatusText"
                       Text=""
                       FontSize="14"
                       Foreground="#888888"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
