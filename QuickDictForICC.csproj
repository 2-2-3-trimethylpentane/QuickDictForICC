<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>QuickDictForICC</AssemblyName>
    <RootNamespace>QuickDictForICC</RootNamespace>
    <!-- 将 NuGet 依赖（含传递依赖）复制到生成输出目录，确保 ICC 调试加载时能找到 NAudio 等程序集 -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- 设置为 true 可在编译后自动打包 .icpx 插件包 -->
    <CreateIcpx>false</CreateIcpx>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="iNKORE.UI.WPF.Modern" Version="0.10.2.1" />
    <PackageReference Include="iNKORE.UI.WPF" Version="1.2.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="6.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="6.0.36" />
    <PackageReference Include="System.Text.Json" Version="6.0.10" />
  </ItemGroup>

  <!-- ICC 宿主 SDK 与控件库。宿主进程已加载这两个程序集，插件包不得分发副本，
       故 ExcludeAssets="runtime" 仅在编译期引用，不复制到输出目录。 -->
  <ItemGroup>
    <PackageReference Include="InkCanvas.PluginSdk" Version="1.7.19.9-gf5eb6eac26" ExcludeAssets="runtime" />
    <PackageReference Include="InkCanvas.Controls" Version="1.7.19.9-gf5eb6eac26" ExcludeAssets="runtime" />
  </ItemGroup>


  <!-- 自动将 manifest.json 复制到输出目录 -->
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*.resx" />
    <None Remove="tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 自动将内置 ECDICT 数据库复制到输出目录 -->
  <ItemGroup>
    <None Include="ecdict\ecdict.db" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 本地化资源文件 -->
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- ICC dynamically loads plugins and does not resolve NuGet native assets through
       this plugin's .deps.json. Put the x64 WebView2 loader beside the plugin DLL so
       WebView2's P/Invoke can find it in the plugin assembly directory. -->
  <Target Name="CopyWebView2LoaderToPluginOutput" AfterTargets="Build">
    <PropertyGroup>
      <WebView2LoaderSource>$(OutDir)runtimes\win-x64\native\WebView2Loader.dll</WebView2LoaderSource>
    </PropertyGroup>
    <Copy SourceFiles="$(WebView2LoaderSource)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(WebView2LoaderSource)')" />
  </Target>

  <Target Name="CopyWebView2LoaderToPluginPublish" AfterTargets="Publish">
    <PropertyGroup>
      <WebView2LoaderSource>$(PublishDir)runtimes\win-x64\native\WebView2Loader.dll</WebView2LoaderSource>
    </PropertyGroup>
    <Copy SourceFiles="$(WebView2LoaderSource)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(WebView2LoaderSource)')" />
  </Target>

</Project>
