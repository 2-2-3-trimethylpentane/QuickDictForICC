<UserControl x:Class="QuickDictForICC.Views.DictionaryPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:p="clr-namespace:QuickDictForICC.Properties"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="480"
             Background="{DynamicResource {x:Static ui:ThemeKeys.SystemControlBackgroundChromeMediumLowBrushKey}}">
    <UserControl.Resources>
        <Style x:Key="SuggestionButton" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <Style x:Key="ScrollArrowButton" TargetType="Button">
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="KeyButton" TargetType="Button" BasedOn="{StaticResource {x:Static ui:ThemeKeys.DefaultButtonStyleKey}}">
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <Style x:Key="FunctionKeyButton" TargetType="Button" BasedOn="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}">
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource {x:Static ui:ThemeKeys.SystemControlBackgroundChromeMediumLowBrushKey}}"
            BorderBrush="{DynamicResource {x:Static ui:ThemeKeys.SystemControlForegroundBaseLowBrushKey}}"
            BorderThickness="1" CornerRadius="12" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid x:Name="TitleBarGrid" Grid.Row="0" Height="56"
                  Background="{DynamicResource {x:Static ui:ThemeKeys.SystemControlBackgroundChromeMediumLowBrushKey}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Margin="16,0,10,0"
                            VerticalAlignment="Center">
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Dictionary}"
                                 FontSize="28"
                                 Foreground="{DynamicResource {x:Static ui:ThemeKeys.SystemControlForegroundAccentBrushKey}}"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{x:Static p:Resources.DictionaryPopup_Title}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource {x:Static ui:ThemeKeys.SystemControlForegroundBaseHighBrushKey}}"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- 搜索区 -->
            <Grid Grid.Row="1" Margin="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox"
                         Grid.Column="0"
                         Style="{DynamicResource {x:Static ui:ThemeKeys.DefaultTextBoxStyleKey}}"
                         FontSize="24"
                         FontWeight="Bold"
                         VerticalContentAlignment="Center"
                         Padding="12,6"/>

                <Button x:Name="ClearButton"
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Margin="8,0,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="{x:Static p:Resources.DictionaryPopup_ClearTooltip}"
                        VerticalAlignment="Center">
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Clear}"
                                 FontSize="14"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- 候选词条区 -->
            <Grid Grid.Row="2" Margin="12,0,12,8" Height="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="SuggestionsScrollLeft"
                        Grid.Column="0"
                        Style="{StaticResource ScrollArrowButton}"
                        Click="SuggestionsScrollLeft_Click"
                        ToolTip="{x:Static p:Resources.DictionaryPopup_ScrollLeftTooltip}">
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChevronLeft}" FontSize="14"/>
                </Button>

                <ScrollViewer x:Name="SuggestionsScrollViewer"
                              Grid.Column="1"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              PanningMode="HorizontalOnly">
                    <StackPanel x:Name="SuggestionsPanel"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- 动态生成建议按钮 -->
                    </StackPanel>
                </ScrollViewer>

                <Button x:Name="SuggestionsScrollRight"
                        Grid.Column="2"
                        Style="{StaticResource ScrollArrowButton}"
                        Click="SuggestionsScrollRight_Click"
                        ToolTip="{x:Static p:Resources.DictionaryPopup_ScrollRightTooltip}">
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChevronRight}" FontSize="14"/>
                </Button>
            </Grid>

            <!-- 结果内容区 -->
            <Border Grid.Row="3"
                    Margin="12,0,12,0"
                    Background="{DynamicResource {x:Static ui:ThemeKeys.SystemControlBackgroundAltMediumHighBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static ui:ThemeKeys.SystemControlForegroundBaseLowBrushKey}}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <ContentControl x:Name="ResultContentHost"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Margin="8">
                        <TextBlock Text="{x:Static p:Resources.DictionaryPopup_EmptyHint}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource {x:Static ui:ThemeKeys.SystemControlForegroundBaseMediumBrushKey}}"
                                   FontSize="14"/>
                    </ContentControl>

                    <!-- 词典加载中覆盖层 -->
                    <Border x:Name="LoadingOverlay"
                            Background="{DynamicResource {x:Static ui:ThemeKeys.SystemControlBackgroundAltMediumHighBrushKey}}"
                            CornerRadius="10"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{x:Static p:Resources.DictionaryPopup_LoadingText}"
                                       FontSize="16"
                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.SystemControlForegroundBaseHighBrushKey}}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LoadingDetailText"
                                       Text="{x:Static p:Resources.DictionaryPopup_LoadingDetail}"
                                       FontSize="12"
                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.SystemControlForegroundBaseMediumBrushKey}}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 虚拟键盘区 -->
            <Grid Grid.Row="4" Margin="8,0,8,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第一行 QWERTYUIOP -->
                <StackPanel x:Name="KeyboardRow1" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Q" Style="{StaticResource KeyButton}" Tag="q" Click="KeyButton_Click"/>
                    <Button Content="W" Style="{StaticResource KeyButton}" Tag="w" Click="KeyButton_Click"/>
                    <Button Content="E" Style="{StaticResource KeyButton}" Tag="e" Click="KeyButton_Click"/>
                    <Button Content="R" Style="{StaticResource KeyButton}" Tag="r" Click="KeyButton_Click"/>
                    <Button Content="T" Style="{StaticResource KeyButton}" Tag="t" Click="KeyButton_Click"/>
                    <Button Content="Y" Style="{StaticResource KeyButton}" Tag="y" Click="KeyButton_Click"/>
                    <Button Content="U" Style="{StaticResource KeyButton}" Tag="u" Click="KeyButton_Click"/>
                    <Button Content="I" Style="{StaticResource KeyButton}" Tag="i" Click="KeyButton_Click"/>
                    <Button Content="O" Style="{StaticResource KeyButton}" Tag="o" Click="KeyButton_Click"/>
                    <Button Content="P" Style="{StaticResource KeyButton}" Tag="p" Click="KeyButton_Click"/>
                </StackPanel>

                <!-- 第二行 ASDFGHJKL -->
                <StackPanel x:Name="KeyboardRow2" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="A" Style="{StaticResource KeyButton}" Tag="a" Click="KeyButton_Click"/>
                    <Button Content="S" Style="{StaticResource KeyButton}" Tag="s" Click="KeyButton_Click"/>
                    <Button Content="D" Style="{StaticResource KeyButton}" Tag="d" Click="KeyButton_Click"/>
                    <Button Content="F" Style="{StaticResource KeyButton}" Tag="f" Click="KeyButton_Click"/>
                    <Button Content="G" Style="{StaticResource KeyButton}" Tag="g" Click="KeyButton_Click"/>
                    <Button Content="H" Style="{StaticResource KeyButton}" Tag="h" Click="KeyButton_Click"/>
                    <Button Content="J" Style="{StaticResource KeyButton}" Tag="j" Click="KeyButton_Click"/>
                    <Button Content="K" Style="{StaticResource KeyButton}" Tag="k" Click="KeyButton_Click"/>
                    <Button Content="L" Style="{StaticResource KeyButton}" Tag="l" Click="KeyButton_Click"/>
                </StackPanel>

                <!-- 第三行 ZXCVBNM -->
                <StackPanel x:Name="KeyboardRow3" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Z" Style="{StaticResource KeyButton}" Tag="z" Click="KeyButton_Click"/>
                    <Button Content="X" Style="{StaticResource KeyButton}" Tag="x" Click="KeyButton_Click"/>
                    <Button Content="C" Style="{StaticResource KeyButton}" Tag="c" Click="KeyButton_Click"/>
                    <Button Content="V" Style="{StaticResource KeyButton}" Tag="v" Click="KeyButton_Click"/>
                    <Button Content="B" Style="{StaticResource KeyButton}" Tag="b" Click="KeyButton_Click"/>
                    <Button Content="N" Style="{StaticResource KeyButton}" Tag="n" Click="KeyButton_Click"/>
                    <Button Content="M" Style="{StaticResource KeyButton}" Tag="m" Click="KeyButton_Click"/>
                </StackPanel>

                <!-- 底部功能键 -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BackspaceButton"
                            Style="{StaticResource FunctionKeyButton}"
                            Click="BackspaceButton_Click"
                            ToolTip="{x:Static p:Resources.DictionaryPopup_BackspaceTooltip}">
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.BackSpaceQWERTY}" FontSize="18"/>
                    </Button>
                    <Button x:Name="SpaceButton"
                            Content="{x:Static p:Resources.DictionaryPopup_SpaceButton}"
                            Style="{StaticResource FunctionKeyButton}"
                            MinWidth="160"
                            Click="SpaceButton_Click"
                            ToolTip="{x:Static p:Resources.DictionaryPopup_SpaceButton}"/>
                    <Button x:Name="KeyboardSearchButton"
                            Content="{x:Static p:Resources.DictionaryPopup_SearchButton}"
                            Style="{DynamicResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"
                            MinWidth="110"
                            MinHeight="46"
                            FontSize="18"
                            FontWeight="Bold"
                            Click="SearchButton_Click"
                            ToolTip="{x:Static p:Resources.DictionaryPopup_SearchButton}"/>
                </StackPanel>
            </Grid>

            <!-- 生成单词卡按钮 -->
            <Border Grid.Row="5"
                    Margin="12,8,12,12"
                    Padding="16,12"
                    Background="{DynamicResource {x:Static ui:ThemeKeys.SystemControlBackgroundAltMediumHighBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static ui:ThemeKeys.SystemControlForegroundBaseLowBrushKey}}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Button x:Name="GenerateCardButton"
                        Content="{x:Static p:Resources.ResultView_GenerateCard}"
                        Style="{DynamicResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"
                        Height="48"
                        Padding="24,0"
                        FontSize="18"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        IsEnabled="False"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
