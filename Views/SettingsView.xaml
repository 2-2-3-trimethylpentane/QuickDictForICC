<UserControl x:Class="QuickDictForICC.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="640"
             Background="White">
    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,24,0,12"/>
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="PathTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BrowseButton" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="0,8,8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#C8C8C8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#106EBE"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="28,20">
        <StackPanel>
            <TextBlock Text="QuickDict 设置"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#222222"
                       Margin="0,0,0,8"/>
            <TextBlock Text="配置词典路径与 TTS 发音选项。修改路径后需重启插件生效。"
                       FontSize="13"
                       Foreground="#888888"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <!-- 词典设置 -->
            <TextBlock Text="词典" Style="{StaticResource SectionHeader}"/>

            <TextBlock Text="ECDICT 文件路径（ecdict.csv）" Style="{StaticResource SettingLabel}"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="EcDictPathTextBox"
                         Grid.Column="0"
                         Style="{StaticResource PathTextBox}"
                         IsReadOnly="True"/>
                <Button x:Name="BrowseEcDictButton"
                        Grid.Column="1"
                        Content="浏览..."
                        Style="{StaticResource BrowseButton}"/>
            </Grid>

            <TextBlock Text="MDict 词典路径（.mdx）" Style="{StaticResource SettingLabel}"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="MDictPathTextBox"
                         Grid.Column="0"
                         Style="{StaticResource PathTextBox}"
                         IsReadOnly="True"/>
                <Button x:Name="BrowseMDictButton"
                        Grid.Column="1"
                        Content="浏览..."
                        Style="{StaticResource BrowseButton}"/>
            </Grid>

            <TextBlock Text="MDict 资源包路径（.mdd，可选）" Style="{StaticResource SettingLabel}"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="MDictResourcePathTextBox"
                         Grid.Column="0"
                         Style="{StaticResource PathTextBox}"
                         IsReadOnly="True"/>
                <Button x:Name="BrowseMDictResourceButton"
                        Grid.Column="1"
                        Content="浏览..."
                        Style="{StaticResource BrowseButton}"/>
            </Grid>

            <!-- TTS 设置 -->
            <TextBlock Text="语音朗读（TTS）" Style="{StaticResource SectionHeader}"/>

            <TextBlock Text="TTS 引擎" Style="{StaticResource SettingLabel}"/>
            <ComboBox x:Name="TtsEngineComboBox"
                      FontSize="14"
                      Padding="10,8"
                      Margin="0,0,0,16"
                      SelectedIndex="0">
                <ComboBoxItem Content="Edge TTS（在线）"/>
                <ComboBoxItem Content="Piper TTS（离线）"/>
            </ComboBox>

            <Grid x:Name="EdgeSettingsPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Edge 音色"
                           Style="{StaticResource SettingLabel}"/>
                <ComboBox x:Name="EdgeVoiceComboBox"
                          Grid.Row="1"
                          FontSize="14"
                          Padding="10,8"
                          Margin="0,0,0,16"
                          IsEditable="True">
                    <ComboBoxItem Content="en-US-AriaNeural"/>
                    <ComboBoxItem Content="en-US-GuyNeural"/>
                    <ComboBoxItem Content="en-GB-SoniaNeural"/>
                    <ComboBoxItem Content="en-US-EmmaMultilingualNeural"/>
                    <ComboBoxItem Content="en-US-JennyNeural"/>
                    <ComboBoxItem Content="en-GB-RyanNeural"/>
                    <ComboBoxItem Content="en-AU-NatashaNeural"/>
                </ComboBox>

                <TextBlock Grid.Row="2"
                           Text="Edge 语速"
                           Style="{StaticResource SettingLabel}"/>
                <Grid Grid.Row="3" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="EdgeRateSlider"
                            Grid.Column="0"
                            Minimum="-50"
                            Maximum="50"
                            Value="0"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="EdgeRateValueText"
                               Grid.Column="1"
                               Text="+0%"
                               FontSize="14"
                               Foreground="#333333"
                               MinWidth="48"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </Grid>
            </Grid>

            <Grid x:Name="PiperSettingsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Piper 可执行文件路径（piper.exe）"
                           Style="{StaticResource SettingLabel}"/>
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PiperExecutablePathTextBox"
                             Grid.Column="0"
                             Style="{StaticResource PathTextBox}"
                             IsReadOnly="True"/>
                    <Button x:Name="BrowsePiperExecutableButton"
                            Grid.Column="1"
                            Content="浏览..."
                            Style="{StaticResource BrowseButton}"/>
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="Piper 模型路径（.onnx）"
                           Style="{StaticResource SettingLabel}"/>
                <Grid Grid.Row="3" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PiperModelPathTextBox"
                             Grid.Column="0"
                             Style="{StaticResource PathTextBox}"
                             IsReadOnly="True"/>
                    <Button x:Name="BrowsePiperModelButton"
                            Grid.Column="1"
                            Content="浏览..."
                            Style="{StaticResource BrowseButton}"/>
                </Grid>
            </Grid>

            <!-- 操作按钮 -->
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button x:Name="SaveButton"
                        Content="保存设置"
                        Style="{StaticResource PrimaryActionButton}"/>
                <Button x:Name="ClearCacheButton"
                        Content="清除 TTS 缓存"
                        Style="{StaticResource ActionButton}"/>
            </StackPanel>

            <!-- 状态文本 -->
            <TextBlock x:Name="StatusText"
                       Text=""
                       FontSize="14"
                       Foreground="#888888"
                       TextWrapping="Wrap"
                       Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
