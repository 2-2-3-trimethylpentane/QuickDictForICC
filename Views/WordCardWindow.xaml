<Window x:Class="QuickDictForICC.Views.WordCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:p="clr-namespace:QuickDictForICC.Properties"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:views="clr-namespace:QuickDictForICC.Views"
        mc:Ignorable="d"
        Title="{x:Static p:Resources.WordCard_Title}"
        Width="480"
        Height="720"
        MinWidth="400"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Topmost="True"
        ui:WindowHelper.UseModernWindowStyle="True">
    <Grid Background="{DynamicResource {x:Static ui:ThemeKeys.SystemControlBackgroundChromeMediumLowBrushKey}}">
        <views:WordCardView x:Name="CardView"
                            Margin="12"/>
    </Grid>
</Window>
