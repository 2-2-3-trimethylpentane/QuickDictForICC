<UserControl x:Class="QuickDictForICC.Views.DictionaryPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="480"
             Background="White">
    <UserControl.Resources>
        <Style x:Key="PopupButtonBase" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#C8C8C8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyButton" TargetType="Button" BasedOn="{StaticResource PopupButtonBase}">
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style x:Key="FunctionKeyButton" TargetType="Button" BasedOn="{StaticResource KeyButton}">
            <Setter Property="Background" Value="#E3E3E3"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>

        <Style x:Key="SuggestionButton" TargetType="Button" BasedOn="{StaticResource PopupButtonBase}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
    </UserControl.Resources>

    <Border Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="12" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid x:Name="TitleBarGrid" Grid.Row="0" Height="48" Background="#F8F8F8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="英汉字典"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="QuickDict"
                               FontSize="12"
                               Foreground="#888888"
                               VerticalAlignment="Center"
                               Margin="8,2,0,0"/>
                </StackPanel>

                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Content="&#xE711;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="12"
                        Width="36"
                        Height="36"
                        Margin="0,0,8,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#666666"
                        VerticalAlignment="Center"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="18">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#E5E5E5"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#CCCCCC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 搜索区 -->
            <Grid Grid.Row="1" Margin="12,12,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#F5F5F5"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8,4">
                    <Grid>
                        <TextBox x:Name="SearchTextBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="16"
                                 VerticalContentAlignment="Center"
                                 Padding="8,4"
                                 Foreground="#333333"
                                 CaretBrush="#333333"
                                 Text=""/>
                    </Grid>
                </Border>

                <Button x:Name="ClearButton"
                        Grid.Column="1"
                        Content="&#xE894;"
                        FontFamily="Segoe MDL2 Assets"
                        Style="{StaticResource PopupButtonBase}"
                        ToolTip="清空"
                        Margin="8,0,0,0"/>

                <Button x:Name="SearchButton"
                        Grid.Column="2"
                        Content="&#xE721;"
                        FontFamily="Segoe MDL2 Assets"
                        ToolTip="搜索"
                        Margin="8,0,0,0">
                    <Button.Style>
                        <Style BasedOn="{StaticResource PopupButtonBase}" TargetType="Button">
                            <Setter Property="Background" Value="#0078D4"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              RecognizesAccessKey="True"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#106EBE"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#005A9E"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- 候选词条区 -->
            <Border Grid.Row="2" Margin="12,0,12,8" Height="46">
                <ScrollViewer x:Name="SuggestionsScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              PanningMode="HorizontalOnly">
                    <StackPanel x:Name="SuggestionsPanel"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- 动态生成建议按钮 -->
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 结果内容区 -->
            <Border Grid.Row="3"
                    Margin="12,0,12,8"
                    Background="#FAFAFA"
                    BorderBrush="#E5E5E5"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <ContentControl x:Name="ResultContentHost"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Margin="12">
                        <TextBlock Text="请输入单词开始查询"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#999999"
                                   FontSize="14"/>
                    </ContentControl>

                    <!-- 词典加载中覆盖层 -->
                    <Border x:Name="LoadingOverlay"
                            Background="#F5F5F5"
                            CornerRadius="10"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="词典加载中..."
                                       FontSize="16"
                                       Foreground="#666666"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LoadingDetailText"
                                       Text="首次使用或词典较大时需要一些时间"
                                       FontSize="12"
                                       Foreground="#999999"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 虚拟键盘区 -->
            <Grid Grid.Row="4" Margin="8,0,8,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第一行 QWERTYUIOP -->
                <StackPanel x:Name="KeyboardRow1" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Q" Style="{StaticResource KeyButton}" Tag="q" Click="KeyButton_Click"/>
                    <Button Content="W" Style="{StaticResource KeyButton}" Tag="w" Click="KeyButton_Click"/>
                    <Button Content="E" Style="{StaticResource KeyButton}" Tag="e" Click="KeyButton_Click"/>
                    <Button Content="R" Style="{StaticResource KeyButton}" Tag="r" Click="KeyButton_Click"/>
                    <Button Content="T" Style="{StaticResource KeyButton}" Tag="t" Click="KeyButton_Click"/>
                    <Button Content="Y" Style="{StaticResource KeyButton}" Tag="y" Click="KeyButton_Click"/>
                    <Button Content="U" Style="{StaticResource KeyButton}" Tag="u" Click="KeyButton_Click"/>
                    <Button Content="I" Style="{StaticResource KeyButton}" Tag="i" Click="KeyButton_Click"/>
                    <Button Content="O" Style="{StaticResource KeyButton}" Tag="o" Click="KeyButton_Click"/>
                    <Button Content="P" Style="{StaticResource KeyButton}" Tag="p" Click="KeyButton_Click"/>
                </StackPanel>

                <!-- 第二行 ASDFGHJKL -->
                <StackPanel x:Name="KeyboardRow2" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="A" Style="{StaticResource KeyButton}" Tag="a" Click="KeyButton_Click"/>
                    <Button Content="S" Style="{StaticResource KeyButton}" Tag="s" Click="KeyButton_Click"/>
                    <Button Content="D" Style="{StaticResource KeyButton}" Tag="d" Click="KeyButton_Click"/>
                    <Button Content="F" Style="{StaticResource KeyButton}" Tag="f" Click="KeyButton_Click"/>
                    <Button Content="G" Style="{StaticResource KeyButton}" Tag="g" Click="KeyButton_Click"/>
                    <Button Content="H" Style="{StaticResource KeyButton}" Tag="h" Click="KeyButton_Click"/>
                    <Button Content="J" Style="{StaticResource KeyButton}" Tag="j" Click="KeyButton_Click"/>
                    <Button Content="K" Style="{StaticResource KeyButton}" Tag="k" Click="KeyButton_Click"/>
                    <Button Content="L" Style="{StaticResource KeyButton}" Tag="l" Click="KeyButton_Click"/>
                </StackPanel>

                <!-- 第三行 ZXCVBNM -->
                <StackPanel x:Name="KeyboardRow3" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Z" Style="{StaticResource KeyButton}" Tag="z" Click="KeyButton_Click"/>
                    <Button Content="X" Style="{StaticResource KeyButton}" Tag="x" Click="KeyButton_Click"/>
                    <Button Content="C" Style="{StaticResource KeyButton}" Tag="c" Click="KeyButton_Click"/>
                    <Button Content="V" Style="{StaticResource KeyButton}" Tag="v" Click="KeyButton_Click"/>
                    <Button Content="B" Style="{StaticResource KeyButton}" Tag="b" Click="KeyButton_Click"/>
                    <Button Content="N" Style="{StaticResource KeyButton}" Tag="n" Click="KeyButton_Click"/>
                    <Button Content="M" Style="{StaticResource KeyButton}" Tag="m" Click="KeyButton_Click"/>
                </StackPanel>

                <!-- 底部功能键 -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BackspaceButton"
                            Content="&#xE750;"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource FunctionKeyButton}"
                            Click="BackspaceButton_Click"
                            ToolTip="退格"/>
                    <Button x:Name="SpaceButton"
                            Content="Space"
                            Style="{StaticResource FunctionKeyButton}"
                            MinWidth="180"
                            Click="SpaceButton_Click"
                            ToolTip="空格"/>
                    <Button x:Name="KeyboardSearchButton"
                            Content="&#xE721;"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource FunctionKeyButton}"
                            Click="SearchButton_Click"
                            ToolTip="搜索"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
