<UserControl x:Class="QuickDictForICC.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:p="clr-namespace:QuickDictForICC.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="640">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 单词标题区 -->
        <Border Grid.Row="0"
                Padding="24,12"
                BorderBrush="#E8E8E8"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="WordText"
                           DockPanel.Dock="Left"
                           FontSize="36"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="PhoneticText"
                               FontSize="18"
                               Foreground="#666666"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Button x:Name="SpeakButton"
                            Width="36"
                            Height="36"
                            ToolTip="{x:Static p:Resources.ResultView_SpeakTooltip}">
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Volume}" FontSize="18"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 释义展示区 -->
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="DefinitionWebView"
                          Visibility="Collapsed"/>
            <ScrollViewer x:Name="TextDefinitionScroll"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16,8">
                    <TextBlock x:Name="PosText"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#00A86B"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="DefinitionText"
                               FontSize="20"
                               Foreground="#333333"
                               TextWrapping="Wrap"
                               LineHeight="32"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="TranslationText"
                               FontSize="20"
                               Foreground="#333333"
                               TextWrapping="Wrap"
                               LineHeight="32"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="ExchangeText"
                               FontSize="18"
                               Foreground="#666666"
                               TextWrapping="Wrap"
                               LineHeight="30"
                               Margin="0,0,0,4"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
