<UserControl x:Class="QuickDictForICC.Views.WordCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:p="clr-namespace:QuickDictForICC.Properties"
             mc:Ignorable="d"
             d:DesignWidth="400" d:DesignHeight="600">
    <Border Background="{DynamicResource {x:Static ui:ThemeKeys.SystemControlBackgroundChromeMediumLowBrushKey}}"
            BorderBrush="{DynamicResource {x:Static ui:ThemeKeys.SystemControlForegroundBaseLowBrushKey}}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Padding="24,16"
                    BorderBrush="{DynamicResource {x:Static ui:ThemeKeys.SystemControlForegroundBaseLowBrushKey}}"
                    BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="WordText"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource {x:Static ui:ThemeKeys.SystemControlForegroundBaseHighBrushKey}}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                        <TextBlock x:Name="PhoneticText"
                                   FontSize="18"
                                   Foreground="{DynamicResource {x:Static ui:ThemeKeys.SystemControlForegroundBaseMediumBrushKey}}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   IsHitTestVisible="False"/>
                    </StackPanel>

                    <Button x:Name="SpeakerButton"
                            DockPanel.Dock="Right"
                            Width="32"
                            Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            VerticalAlignment="Center"
                            ToolTip="{x:Static p:Resources.ResultView_SpeakTooltip}">
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Volume}"
                                     FontSize="18"
                                     Foreground="{DynamicResource {x:Static ui:ThemeKeys.SystemControlForegroundAccentBrushKey}}"/>
                    </Button>
                </DockPanel>
            </Border>

            <!-- 内容区：垂直滚动，按顺序展示释义/词组/例句/近义词 -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- 释义 -->
                    <StackPanel x:Name="DefinitionSection"
                                Margin="20,12"
                                Visibility="Collapsed">
                        <TextBlock Text="{x:Static p:Resources.ResultTab_Definition}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource {x:Static ui:ThemeKeys.SystemControlForegroundBaseHighBrushKey}}"
                                   IsHitTestVisible="False"/>
                        <StackPanel x:Name="DefinitionPanel"
                                    Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- 词组 -->
                    <StackPanel x:Name="PhrasesSection"
                                Margin="20,12"
                                Visibility="Collapsed">
                        <TextBlock Text="{x:Static p:Resources.ResultTab_Phrases}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource {x:Static ui:ThemeKeys.SystemControlForegroundBaseHighBrushKey}}"
                                   IsHitTestVisible="False"/>
                        <StackPanel x:Name="PhrasesPanel"
                                    Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- 例句 -->
                    <StackPanel x:Name="SentencesSection"
                                Margin="20,12"
                                Visibility="Collapsed">
                        <TextBlock Text="{x:Static p:Resources.ResultTab_Sentences}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource {x:Static ui:ThemeKeys.SystemControlForegroundBaseHighBrushKey}}"
                                   IsHitTestVisible="False"/>
                        <StackPanel x:Name="SentencesPanel"
                                    Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- 近义词 -->
                    <StackPanel x:Name="SynonymsSection"
                                Margin="20,12"
                                Visibility="Collapsed">
                        <TextBlock Text="{x:Static p:Resources.ResultTab_Synonyms}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource {x:Static ui:ThemeKeys.SystemControlForegroundBaseHighBrushKey}}"
                                   IsHitTestVisible="False"/>
                        <StackPanel x:Name="SynonymsPanel"
                                    Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>
</UserControl>
